// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERUSER
  ADMIN
  SUPERVISOR
  CASHIER
}

model Pos {
  id           String   @id @default(cuid())
  name         String
  location     String
  deviceName   String
  isActive     Boolean  @default(false)
  activeUserId String?  @unique
  activeUser   User?    @relation(fields: [activeUserId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pos")
}

model User {
  id              String    @id @default(cuid())
  name            String
  image           String?
  email           String?   @unique
  emailVerified   Boolean   @default(false)
  roles           Role[]    @default([CASHIER])
  username        String    @unique
  displayUsername String?   @unique
  sessions        Session[]
  accounts        Account[]
  lastActive      DateTime?

  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cashShifts   CashShift[]
  auditLogs    AuditLog[]
  activePos    Pos?

  @@map("user")
}

model Session {
  id          String   @id @default(cuid())
  expiresAt   DateTime
  token       String   @unique
  createdAt   DateTime
  updatedAt   DateTime
  ipAddress   String?
  userAgent   String?
  userId      String
  activeRole  Role?
  activePosId String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Product {
  id                String            @id @default(cuid())
  sku               String            @unique
  name              String
  images            String[]          @default([])
  hpp               Float
  price             Float
  totalStock        Int               @default(0)
  lowStockThreshold Int               @default(10)
  items             TransactionItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  category          Category?         @relation(fields: [categoryId], references: [id])
  categoryId        String?
  discount          Discount[]
  stockBatches      StockBatch[]
}

model Discount {
  id                 String       @id @default(cuid())
  name               String
  description        String?
  type               DiscountType @default(PERCENTAGE)
  value              Float
  startDate          DateTime     @default(now())
  endDate            DateTime
  isActive           Boolean      @default(true)
  isTransactionLevel Boolean      @default(false)
  isMemberLevel      Boolean      @default(false)

  products     Product[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique @default(cuid())
  hasExpiry Boolean   @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Member {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Transaction {
  id            String            @id @default(cuid())
  invoiceNumber String            @unique
  customerName  String?
  totalGross    Float
  totalDiscount Float             @default(0)
  totalNet      Float
  totalProfit   Float
  totalHpp      Float             @default(0)
  paymentMethod String
  cashReceived  Float?
  change        Float?
  status        TransactionStatus @default(PENDING)

  userId   String
  user     User              @relation(fields: [userId], references: [id])
  memberId String?
  member   Member?           @relation(fields: [memberId], references: [id])
  items    TransactionItem[]
  discount Discount[]

  createdAt DateTime @default(now())
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  qty           Int
  priceAtSale   Float
  hppAtSale     Float
  totalDiscount Float @default(0)
  subtotal      Float
}

model StockBatch {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  initialQuantity   Int
  remainingQuantity Int
  purchasePrice     Float
  expiryDate        DateTime?
  createdAt         DateTime  @default(now())
}

model CashShift {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  startTime    DateTime    @default(now())
  endTime      DateTime?
  startingCash Float
  expectedCash Float?
  actualCash   Float?
  difference   Float?
  status       ShiftStatus @default(OPEN)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

enum ShiftStatus {
  OPEN
  CLOSED
}
